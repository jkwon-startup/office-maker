{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{3,6}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "status": {
            "enum": [
              "draft",
              "ready",
              "retired"
            ]
          },
          "modes": {
            "type": "array",
            "items": {
              "const": "design_system"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "design": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "font": {
                "type": "string",
                "minLength": 1
              },
              "bodyPt": {
                "type": "number",
                "minimum": 6,
                "maximum": 36
              },
              "headerColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "columnWidth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 255
              },
              "orientation": {
                "enum": [
                  "portrait",
                  "landscape"
                ]
              }
            },
            "required": [
              "font",
              "bodyPt",
              "headerColor",
              "columnWidth",
              "orientation"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "privacy": {
                "enum": [
                  "pending",
                  "passed"
                ]
              },
              "visual": {
                "enum": [
                  "pending",
                  "passed"
                ]
              },
              "compatibility": {
                "enum": [
                  "pending",
                  "passed"
                ]
              }
            },
            "required": [
              "privacy",
              "visual",
              "compatibility"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "status",
          "modes",
          "design",
          "checks"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "properties": {
                "checks": {
                  "properties": {
                    "privacy": {
                      "const": "passed"
                    },
                    "visual": {
                      "const": "passed"
                    },
                    "compatibility": {
                      "const": "passed"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "templates"
  ],
  "title": "excel template registry"
}
